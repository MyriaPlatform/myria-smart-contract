{
  "name": "myria-smart-contracts",
  "version": "2.0.0",
  "description": "Myria smart contracts for ERC20 and ERC721 tokens with minting capabilities",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "build": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:erc721": "hardhat run scripts/deploy_erc721.js",
    "deploy:erc20": "hardhat run scripts/deploy_erc20.js",
    "deploy:erc721:sepolia": "hardhat run scripts/deploy_erc721.js --network sepolia",
    "deploy:erc20:sepolia": "hardhat run scripts/deploy_erc20.js --network sepolia",
    "deploy:erc721:mainnet": "hardhat run scripts/deploy_erc721.js --network mainnet",
    "deploy:erc20:mainnet": "hardhat run scripts/deploy_erc20.js --network mainnet",
    "deploy:erc721:polygon": "hardhat run scripts/deploy_erc721.js --network polygon",
    "deploy:erc20:polygon": "hardhat run scripts/deploy_erc20.js --network polygon",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "format": "prettier --write 'contracts/**/*.sol' 'scripts/**/*.js' 'test/**/*.js'",
    "verify": "hardhat verify",
    "node": "hardhat node",
    "console": "hardhat console",
    "flatten": "hardhat flatten",
    "size": "hardhat size-contracts",
    "gas-report": "REPORT_GAS=true hardhat test"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "smart-contracts",
    "myria",
    "erc20",
    "erc721",
    "nft",
    "hardhat"
  ],
  "author": "Myria Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.4",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.9",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^1.1.1",
    "@typechain/ethers-v6": "^0.4.3",
    "@typechain/hardhat": "^8.0.3",
    "@types/chai": "^4.3.6",
    "@types/mocha": "^10.0.2",
    "@types/node": "^20.8.0",
    "chai": "^4.3.8",
    "ethers": "^6.8.0",
    "hardhat": "^2.17.3",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.9",
    "prettier": "^3.0.3",
    "prettier-plugin-solidity": "^1.1.3",
    "solhint": "^4.0.0",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.1",
    "typechain": "^8.3.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.3.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/myria/myria-smart-contract.git"
  },
  "bugs": {
    "url": "https://github.com/myria/myria-smart-contract/issues"
  },
  "homepage": "https://github.com/myria/myria-smart-contract#readme"
}